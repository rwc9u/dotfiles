# Work-only packages. Installed by bin/install only when WORK=1.

tap "argoproj/tap"
tap "caarlos0/tap"
tap "depot/tap"
tap "hashicorp/tap"
tap "kreuzwerker/taps"
tap "puma/puma"
brew "ansible"
brew "argocd"
brew "awscli"
brew "awsume"
brew "circleci"
brew "container-diff"
brew "helm"
brew "kubernetes-cli"
brew "kube-ps1"
brew "kubectx"
brew "kustomize"
brew "memcached", restart_service: true
brew "minikube"
brew "overmind"
brew "postgresql@12", restart_service: true
brew "redis", restart_service: true
brew "terraformer"
brew "vault"
brew "argoproj/tap/kubectl-argo-rollouts"
brew "caarlos0/tap/org-stats"
brew "depot/tap/depot"
brew "hashicorp/tap/terraform-ls"
brew "kreuzwerker/taps/m1-terraform-provider-helper"
brew "puma/puma/puma-dev"
cask "aws-vpn-client"
cask "datadog-agent"
cask "loom"
cask "ngrok"
cask "tuple"
brew "qt"
